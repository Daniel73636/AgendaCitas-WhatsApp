# ============================================================
# Agenda de citas con WhatsApp - variables de entorno
# Copia este archivo a `.env` en la raiz del monorepo.
# ============================================================

# --- Base de datos -----------------------------------------
# Con Docker (docker compose up -d):
#   DATABASE_URL=postgres://agenda:agenda@localhost:5432/agenda
# SIN Docker: deja DATABASE_URL vacio/comentado. La API usara PGlite
# (PostgreSQL embebido en WASM, con btree_gist y la restriccion EXCLUDE real).
DATABASE_URL=
# Solo modo PGlite: carpeta de persistencia. Vacio = en memoria (se reinicia).
PGLITE_DIR=
# Sembrar datos demo al arrancar si la BD esta vacia (true/false)
AUTO_SEED=true

# Puertos de docker-compose (cambialos si 5432/6379 ya estan ocupados en tu maquina)
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# --- Redis / BullMQ (opcional) -----------------------------
# Si esta vacio, los recordatorios corren en un planificador embebido en la API.
REDIS_URL=

# --- API ---------------------------------------------------
API_PORT=4100
API_HOST=0.0.0.0
# Secreto para firmar sesiones y enlaces de cita (cambiar en produccion)
AUTH_SECRET=dev-secret-cambia-esto-en-produccion-32chars
# Clave de 32 bytes en hex/base64/texto para cifrar notas de clientes (AES-256-GCM)
FIELD_ENCRYPTION_KEY=dev-field-key-cambia-esto-en-produccion
# Origenes permitidos CORS (coma). Vacio = reflejar cualquier origen (solo dev). En produccion es obligatorio.
CORS_ORIGINS=
# true solo detras de un proxy propio (lee X-Forwarded-For)
TRUST_PROXY=false
# Ejecutar el planificador de recordatorios dentro de la API
EMBEDDED_WORKER=true
# Secreto para que apps/worker invoque /v1/internal/jobs/tick
INTERNAL_JOBS_SECRET=dev-internal-secret

# --- Demo --------------------------------------------------
# true solo en la maquina de desarrollo: OTP 123456, cuenta demo y pago simulado.
# En produccion debe ser false (o ausente). NODE_ENV=production + DEMO_MODE=true no arranca.
DEMO_MODE=true

# --- OTP y WhatsApp ----------------------------------------
# mock: el codigo siempre es OTP_MOCK_CODE y no se envia nada real (ademas exige DEMO_MODE=true)
OTP_MODE=mock
OTP_MOCK_CODE=123456
# mock: los mensajes se registran en consola y en message_log. cloud: WhatsApp Cloud API real
WHATSAPP_MODE=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# App Secret de Meta. Obligatorio si WHATSAPP_MODE=cloud (firma X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=agenda-verify-token
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_LANGUAGE=es

# --- Web (Next.js) -----------------------------------------
# URL de la API vista desde el servidor de Next (SSR)
API_URL=http://localhost:4100
# URL publica de la API vista desde el navegador. Vacio = mismo host que la web, puerto 4100
# (asi funciona automaticamente en Android dentro de la red local)
NEXT_PUBLIC_API_URL=
# URL publica de la web (para enlaces en mensajes de WhatsApp)
PUBLIC_WEB_URL=http://localhost:3100

# Anticipo publico: none (no cobra) o mock (solo con DEMO_MODE=true). wompi no esta implementado y la API no arranca.
# En desarrollo, con DEMO_MODE=true, puedes usar mock para el boton "Pagar ahora (simulado)".
PAYMENTS_PROVIDER=mock

# Marca del negocio (logo, portada, color #rrggbb): NO son variables de entorno.
# Se guardan por tenant en el panel → Ajustes y la pagina publica /{slug} las lee de la API.
